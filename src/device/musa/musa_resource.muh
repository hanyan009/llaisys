#pragma once

#include "../device_resource.hpp"

#include <mublas.h>

namespace llaisys::device::musa {
class Resource : public llaisys::device::DeviceResource {
public:
    Resource(int device_id);
    ~Resource();

    mublasHandle_t mublas_handle() { return mublas_handle_; }

private:
    mublasHandle_t mublas_handle_;
};

Resource* get_resource(int device_id);

} // namespace llaisys::device::musa
